{
  "manifest_version": 3,
  "name": "VRC Favorite World History",
  "short_name": "VRC World History",
  "version": "0.1.0",
  "description": "VRChatのお気に入りワールド名と変化を、このブラウザ内だけに記録します。",
  "homepage_url": "https://github.com/Na2ki-BB/vrc_favworld_check",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "notifications",
    "unlimitedStorage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://api.vrchat.cloud/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "お気に入りワールドを確認",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "dashboard.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
